<div data-controller="rowdy-dropzone"
     data-rowdy-dropzone-url-value="<%= dropzone_url %>"
     data-rowdy-dropzone-uploading-label-value="<%= I18n.t('rowdy.dropzone.uploading') %>"
     <% if chunked? %>
     data-rowdy-dropzone-chunked-url-value="<%= chunked_upload_url %>"
     data-rowdy-dropzone-worker-url-value="<%= worker_url %>"
     data-rowdy-dropzone-chunk-size-value="<%= chunk_size_value %>"
     data-rowdy-dropzone-pending-uploads-value="<%= pending_uploads_data %>"
     <% end %>
     <% if schema_name %>
     data-rowdy-dropzone-schema-name-value="<%= schema_name %>"
     <% end %>
     <%= tag.attributes(html_options) %>>

  <div class="rowdy-dropzone-area"
       data-rowdy-dropzone-target="dropzone"
       data-action="
         dragover->rowdy-dropzone#handleDragOver
         dragleave->rowdy-dropzone#handleDragLeave
         drop->rowdy-dropzone#handleDrop
         click->rowdy-dropzone#openFilePicker">
    <div class="rowdy-dropzone-label-wrap">
      <div data-rowdy-dropzone-target="dropzoneLabel" data-original-label="<%= label_text %>">
        <svg class="rowdy-dropzone-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="17 8 12 3 7 8"/>
          <line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
        <span><%= label_text %></span>
        <span class="rowdy-dropzone-hint"><%= I18n.t('rowdy.dropzone.hint', default: '.xlsx or .xls files') %></span>
      </div>
      <div class="rowdy-dropzone-uploading hidden" data-rowdy-dropzone-target="dropzoneUploading">
        <span class="rowdy-dropzone-spinner" aria-hidden="true"></span>
        <span class="rowdy-dropzone-uploading-text"><%= I18n.t('rowdy.dropzone.uploading') %></span>
      </div>
    </div>
  </div>

  <input type="file"
         data-rowdy-dropzone-target="fileInput"
         data-action="change->rowdy-dropzone#handleFileSelect"
         accept="<%= accept %>"
         <%= 'multiple' if multiple %>
         style="display: none;">

  <input type="file"
         data-rowdy-dropzone-target="resumeFileInput"
         data-action="change->rowdy-dropzone#handleResumeFileSelect"
         accept="<%= accept %>"
         style="display: none;">

  <div class="rowdy-resume-banner hidden" data-rowdy-dropzone-target="resumeBanner"></div>

  <div class="rowdy-file-list <%= "rowdy-file-list--hidden" unless show_file_list %>" data-rowdy-dropzone-target="fileList"></div>
  <div class="rowdy-upload-progress hidden" data-rowdy-dropzone-target="uploadProgress"></div>
</div>
