<tr class="rowdy-upload-item" id="rowdy_upload_<%= @upload.id %>" data-upload-id="<%= @upload.id %>" data-upload-status="<%= @upload.status %>">
  <td class="rowdy-upload-filename-cell">
    <span class="rowdy-upload-filename"><%= @upload.filename %></span>
  </td>

  <td class="rowdy-upload-status-cell">
    <span class="rowdy-upload-status"><%= I18n.t("rowdy.status.#{@upload.status}") %></span>
    <% if @upload.processing? %>
      <div class="rowdy-upload-progress-bar rowdy-upload-progress-bar--inline">
        <progress value="<%= @upload.progress %>" max="100"></progress>
        <span class="rowdy-upload-progress-text"><%= @upload.progress %>%</span>
      </div>
    <% end %>
    <% if @upload.failed? %>
      <span class="rowdy-error-message"><%= @upload.error_message %></span>
    <% end %>
  </td>

  <td class="rowdy-upload-action-cell">
    <% if @upload.completed? && importable? %>
      <%= button_to create_import_path, method: :post, class: "rowdy-btn rowdy-btn--secondary rowdy-btn--icon", data: { turbo_frame: "rowdy-steps-#{@upload.schema_name}" }, aria: { label: I18n.t("rowdy.upload_item.start_import") } do %>
        <%= render "rowdy/shared/icons/arrow_right" %>
      <% end %>
    <% end %>
  </td>
</tr>
