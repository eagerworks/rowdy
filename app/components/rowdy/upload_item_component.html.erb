<div class="rowdy-upload-item" id="rowdy_upload_<%= @upload.id %>" data-upload-id="<%= @upload.id %>" data-upload-status="<%= @upload.status %>">
  <div class="rowdy-upload-info">
    <span class="rowdy-upload-filename"><%= @upload.filename %></span>
    <span class="rowdy-upload-status"><%= I18n.t("rowdy.status.#{@upload.status}") %></span>
  </div>

  <% if @upload.processing? %>
    <div class="rowdy-upload-progress-bar">
      <progress value="<%= @upload.progress %>" max="100"></progress>
      <span class="rowdy-upload-progress-text"><%= @upload.progress %>%</span>
    </div>
  <% end %>

  <% if @upload.completed? && importable? %>
    <div class="rowdy-upload-actions">
      <%= button_to I18n.t("rowdy.upload_item.start_import"), create_import_path, method: :post, class: "rowdy-btn rowdy-btn--primary rowdy-btn--sm", data: { turbo_frame: "rowdy-template-steps-#{@upload.schema_name}" } %>
    </div>
  <% end %>

  <% if @upload.failed? %>
    <div class="rowdy-upload-error">
      <span class="rowdy-error-message"><%= @upload.error_message %></span>
    </div>
  <% end %>
</div>
