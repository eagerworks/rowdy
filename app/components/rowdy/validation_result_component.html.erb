<div class="rowdy-validation-result">
  <% if in_progress? %>
    <div data-controller="rowdy-validate"
         data-rowdy-validate-url-value="<%= start_validation_path %>"></div>
    <div id="rowdy-import-progress-<%= import.id %>" class="rowdy-validation-progress">
      <% if preparing? %>
        <%= render "rowdy/shared/icons/clock" %>
        <p class="rowdy-validation-status"><%= I18n.t("rowdy.import.validation.preparing") %></p>
      <% else %>
        <p class="rowdy-validation-status"><%= I18n.t("rowdy.import.validation.in_progress") %></p>
        <div class="rowdy-upload-progress-bar">
          <progress value="<%= import.progress %>" max="100"></progress>
          <span class="rowdy-upload-progress-text"><%= import.progress %>%</span>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if validated? %>
    <div class="rowdy-validation-summary">
      <p class="rowdy-validation-total">
        <%= I18n.t("rowdy.import.validation.summary_total", total: @import.total_rows) %>
      </p>
      <p class="rowdy-validation-detail">
        <%= I18n.t("rowdy.import.validation.summary_detail",
          valid: @import.valid_rows_count,
          invalid: @import.invalid_rows_count) %>
      </p>
    </div>

    <% if has_errors? %>
      <div data-controller="rowdy-find-replace">
        <%= render Rowdy::FindReplaceComponent.new(import:, tabs:) %>

        <%= form_with url: correct_errors_path, method: :patch,
              data: { controller: "rowdy-dirty-form", turbo_frame: frame_id },
              html: { id: "rowdy-corrections-form-#{import.id}" } do |f| %>
          <%= hidden_field_tag :page, page %>
          <%= hidden_field_tag :current_tab, current_tab %>

          <div class="rowdy-validation-tabs">
            <div class="rowdy-validation-tabs-nav" role="tablist">
              <% error_types.each_with_index do |error_type, i| %>
                <%= link_to validation_path(page: 1, current_tab: i),
                      class: "rowdy-validation-tab #{'rowdy-validation-tab--active' if i == current_tab}",
                      role: "current_tab",
                      aria: { selected: i == current_tab },
                      title: label_for_error_type(error_type),
                      data: {
                        turbo_frame: frame_id,
                        action: "click->rowdy-dirty-form#confirmNavigation"
                      } do %>
                  <span class="rowdy-validation-tab-label"><%= label_for_error_type(error_type) %></span>
                  <span class="rowdy-validation-tab-count">(<%= row_count_for_error_type(error_type) %>)</span>
                <% end %>
              <% end %>
            </div>

            <% active_type = error_types[current_tab] %>
            <% if active_type %>
              <div class="rowdy-validation-tab-panel rowdy-validation-tab-panel--active" role="tabpanel">
                <table class="rowdy-validation-table">
                  <thead>
                    <tr>
                      <th><%= I18n.t("rowdy.import.validation.row_number") %></th>
                      <th><%= I18n.t("rowdy.import.validation.column") %></th>
                      <th><%= I18n.t("rowdy.import.validation.error") %></th>
                      <th><%= I18n.t("rowdy.import.validation.value") %></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% entries_for_error_type(active_type).each do |entry| %>
                      <%= render Rowdy::InvalidRowComponent.new(
                        import_row: entry[:import_error],
                        column: entry[:column],
                        messages: entry[:messages]
                      ) %>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% end %>
          </div>

          <div class="rowdy-validation-pagination">
            <% if previous_page? %>
              <%= link_to I18n.t("rowdy.import.validation.previous"),
                validation_path(page: page - 1),
                class: "rowdy-btn",
                data: {
                  turbo_frame: frame_id,
                  action: "click->rowdy-dirty-form#confirmNavigation"
                } %>
            <% end %>

            <span class="rowdy-validation-page-info">
              <%= I18n.t("rowdy.import.validation.page_info", page: page, total: total_pages) %>
            </span>

            <% if next_page? %>
              <%= link_to I18n.t("rowdy.import.validation.next"),
                validation_path(page: page + 1),
                class: "rowdy-btn",
                data: {
                  turbo_frame: frame_id,
                  action: "click->rowdy-dirty-form#confirmNavigation"
                } %>
            <% end %>
          </div>

          <% if import.error_report.attached? %>
            <div class="rowdy-validation-report">
              <%= link_to I18n.t("rowdy.import.validation.download_report"),
                error_report_path,
                class: "rowdy-btn rowdy-btn--alert rowdy-btn--sm",
                data: { turbo: false } %>
            </div>
          <% end %>

          <div class="rowdy-validation-actions">
            <%= link_to I18n.t("rowdy.import.validation.back_to_mapping"),
              mapping_path,
              class: "rowdy-btn",
              data: { turbo_frame: frame_id } %>

            <div class="rowdy-validation-actions-right">
              <button type="button" class="rowdy-btn"
                      data-action="click->rowdy-find-replace#open">
                <%= I18n.t("rowdy.import.find_replace.button") %>
              </button>

              <%= f.submit I18n.t("rowdy.import.validation.save_corrections"), class: "rowdy-btn rowdy-btn--primary" %>

              <% if has_valid_rows? %>
                <button type="button" class="rowdy-btn rowdy-btn--primary" disabled>
                  <%= I18n.t("rowdy.import.validation.import_valid_rows", count: @import.valid_rows_count) %>
                </button>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rowdy-validation-actions">
        <%= link_to I18n.t("rowdy.import.validation.back_to_mapping"),
          mapping_path,
          class: "rowdy-btn",
          data: { turbo_frame: frame_id } %>

        <% if has_valid_rows? %>
          <button type="button" class="rowdy-btn rowdy-btn--primary" disabled>
            <%= I18n.t("rowdy.import.validation.import_valid_rows", count: import.valid_rows_count) %>
          </button>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
