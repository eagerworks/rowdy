<div data-controller="rowdy-schema-builder">
  <button type="button" class="rowdy-btn rowdy-btn--primary" data-action="click->rowdy-schema-builder#open">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    <%= t('rowdy.schema_builder.create_schema') %>
  </button>

  <dialog class="rowdy-schema-dialog" data-rowdy-schema-builder-target="dialog" data-action="click->rowdy-schema-builder#closeOnBackdrop">
    <div class="rowdy-schema-dialog-content">
      <div class="rowdy-schema-dialog-header">
        <h3 class="rowdy-schema-dialog-title"><%= t('rowdy.schema_builder.dialog_title') %></h3>
        <button type="button" class="rowdy-schema-dialog-close" data-action="click->rowdy-schema-builder#close">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div id="schema-builder-errors" class="rowdy-schema-error-container" data-rowdy-schema-builder-target="errorContainer"></div>

      <%= form_with url: endpoint_url, scope: :schema_definition, data: { rowdy_schema_builder_target: "form" } do |f| %>
        <div class="rowdy-schema-meta-fields">
          <div class="rowdy-schema-field">
            <label class="rowdy-schema-field-label"><%= t('rowdy.schema_builder.schema_name') %> <span class="rowdy-schema-hint"><%= t('rowdy.schema_builder.snake_case_hint') %></span></label>
            <%= f.text_field :name, class: "rowdy-schema-input", placeholder: t('rowdy.schema_builder.name_placeholder'), required: true %>
          </div>
          <div class="rowdy-schema-field">
            <label class="rowdy-schema-field-label"><%= t('rowdy.schema_builder.label') %> <span class="rowdy-schema-hint"><%= t('rowdy.schema_builder.optional_hint') %></span></label>
            <%= f.text_field :label, class: "rowdy-schema-input", placeholder: t('rowdy.schema_builder.label_placeholder') %>
          </div>
        </div>

        <div class="rowdy-schema-columns-section">
          <div class="rowdy-schema-columns-header">
            <h4 class="rowdy-schema-columns-title"><%= t('rowdy.schema_builder.columns') %></h4>
            <button type="button" class="rowdy-btn rowdy-btn--sm" data-action="click->rowdy-schema-builder#addColumn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <%= t('rowdy.schema_builder.add_column') %>
            </button>
          </div>
          <div data-rowdy-schema-builder-target="columnsContainer"></div>
        </div>

        <div class="rowdy-schema-dialog-actions">
          <button type="button" class="rowdy-btn" data-action="click->rowdy-schema-builder#close"><%= t('rowdy.schema_builder.cancel') %></button>
          <%= f.submit t('rowdy.schema_builder.create_schema'), class: "rowdy-btn rowdy-btn--primary", data: { turbo_submits_with: t('rowdy.schema_builder.creating') } %>
        </div>
      <% end %>
    </div>
  </dialog>

  <template data-rowdy-schema-builder-target="columnTemplate">
    <div class="rowdy-schema-column-row">
      <div class="rowdy-schema-column-fields">
        <div class="rowdy-schema-field rowdy-schema-field--name">
          <label class="rowdy-schema-field-label"><%= t('rowdy.schema_builder.column_name') %></label>
          <input type="text" name="schema_definition[columns_config][__INDEX__][name]" placeholder="column_name" class="rowdy-schema-input" />
        </div>
        <div class="rowdy-schema-field rowdy-schema-field--type">
          <label class="rowdy-schema-field-label"><%= t('rowdy.schema_builder.column_type') %></label>
          <select name="schema_definition[columns_config][__INDEX__][type]" class="rowdy-schema-select" data-action="change->rowdy-schema-builder#toggleInclusion">
            <option value="string"><%= t('rowdy.schema_builder.types.string') %></option>
            <option value="integer"><%= t('rowdy.schema_builder.types.integer') %></option>
            <option value="float"><%= t('rowdy.schema_builder.types.float') %></option>
            <option value="decimal"><%= t('rowdy.schema_builder.types.decimal') %></option>
            <option value="date"><%= t('rowdy.schema_builder.types.date') %></option>
            <option value="boolean"><%= t('rowdy.schema_builder.types.boolean') %></option>
          </select>
        </div>
        <div class="rowdy-schema-field rowdy-schema-field--checkbox">
          <label class="rowdy-schema-checkbox-label">
            <input type="hidden" name="schema_definition[columns_config][__INDEX__][required]" value="0" />
            <input type="checkbox" name="schema_definition[columns_config][__INDEX__][required]" value="1" />
            <%= t('rowdy.schema_builder.required') %>
          </label>
        </div>
        <div class="rowdy-schema-field rowdy-schema-field--checkbox">
          <label class="rowdy-schema-checkbox-label">
            <input type="hidden" name="schema_definition[columns_config][__INDEX__][unique]" value="0" />
            <input type="checkbox" name="schema_definition[columns_config][__INDEX__][unique]" value="1" />
            <%= t('rowdy.schema_builder.unique') %>
          </label>
        </div>
        <div class="rowdy-schema-field rowdy-schema-field--narrow">
          <label class="rowdy-schema-field-label"><%= t('rowdy.schema_builder.max_length') %></label>
          <input type="number" name="schema_definition[columns_config][__INDEX__][max_length]" placeholder="—" min="1" class="rowdy-schema-input" />
        </div>
        <div class="rowdy-schema-field rowdy-schema-field--narrow">
          <label class="rowdy-schema-field-label"><%= t('rowdy.schema_builder.greater_than') %></label>
          <input type="number" name="schema_definition[columns_config][__INDEX__][greater_than]" placeholder="—" step="any" class="rowdy-schema-input" />
        </div>
        <div class="rowdy-schema-field rowdy-schema-field--remove">
          <button type="button" class="rowdy-schema-remove-col-btn" data-action="click->rowdy-schema-builder#removeColumn" title="<%= t('rowdy.schema_builder.remove_column') %>">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>
      <div class="rowdy-schema-inclusion-group" style="display: none;">
        <label class="rowdy-schema-field-label"><%= t('rowdy.schema_builder.allowed_values') %> <span class="rowdy-schema-hint"><%= t('rowdy.schema_builder.comma_separated_hint') %></span></label>
        <input type="text" name="schema_definition[columns_config][__INDEX__][inclusion]" placeholder="<%= t('rowdy.schema_builder.inclusion_placeholder') %>" class="rowdy-schema-input" />
      </div>
    </div>
  </template>
</div>
