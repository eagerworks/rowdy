<tr>
  <td><%= @import_error.row_number %></td>
  <td><%= @column %></td>
  <td><%= @messages.join(", ") %></td>
  <td>
    <input type="text"
           name="<%= input_name %>"
           value="<%= current_value %>"
           class="rowdy-inline-edit-input"
           data-original-value="<%= current_value %>"
           data-controller="rowdy-inline-edit"
           data-action="keydown->rowdy-inline-edit#revert">
  </td>
</tr>
