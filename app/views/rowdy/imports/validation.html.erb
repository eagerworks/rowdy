<turbo-frame id="<%= @import.steps_frame_id %>">
  <%= render Rowdy::StepsComponent.new(import: @import) do %>
    <%= render Rowdy::ValidationResultComponent.new(
      import: @import,
      errors: @errors,
      page: @page,
      total_pages: @total_pages,
      tabs: @tabs,
      current_tab: @current_tab,
      error_types_with_counts: @error_types_with_counts
    ) %>
  <% end %>
</turbo-frame>
